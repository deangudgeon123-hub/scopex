# Demo is the default and never reads or writes Supabase.
SCOPEX_DATA_MODE=demo
# For real workspace data, set mode to supabase and configure both values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# No service role key is needed or used by the web application.

# Development-only operator scan gate. Leave disabled unless you are actively testing
# an explicitly authorised domain. Targets are exact-match only; wildcards are not supported.
SCOPEX_OPERATOR_MODE=disabled
SCOPEX_ALLOWED_TARGETS=
# Use a random 32+ character secret. Store the same value in the private Supabase operator context.
SCOPEX_OPERATOR_TOKEN=

# Native scanner worker. It can reuse the publishable Supabase values above.
SCOPEX_WORKER_ID=scopex-native-1
SCOPEX_WORKER_POLL_MS=5000
